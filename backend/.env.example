# Backend environment configuration.
# Copy this file to `.env` and fill in real values. Never commit a real `.env`.
# All variables are read through backend/app/core/config.py (Pydantic settings).

# ---- Application ----
APP_NAME=LectureWeave
APP_ENV=development         # development | testing | production
APP_DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# ---- Server ----
HOST=0.0.0.0
PORT=8000                    # keep in sync with frontend VITE_API_BASE_URL

# ---- CORS ----
# Comma-separated origins. Do NOT use "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# ---- Database (MongoDB) ----
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=lectureweave

# ---- Authentication (JWT) ----
# Generate a long random value, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ACCESS_TOKEN_EXPIRE_DAYS=30

# ---- LLM (Groq) ----
# Get a key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ---- Speech-to-text (Faster Whisper) ----
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---- Embeddings (Sentence Transformers) ----
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_INDEX_NAME=vector_search

# ---- Document processing and hybrid retrieval ----
DOCUMENT_CHUNKER=structure
DOCUMENT_CHUNK_SIZE=1200
DOCUMENT_CHUNK_OVERLAP=150
DOCUMENT_MIN_CHUNK_SIZE=200
RETRIEVAL_VECTOR_LIMIT=10
RETRIEVAL_KEYWORD_LIMIT=10
RETRIEVAL_FINAL_LIMIT=5
RETRIEVAL_MIN_SCORE=0.0
RETRIEVAL_VECTOR_WEIGHT=0.6
RETRIEVAL_KEYWORD_WEIGHT=0.4
RETRIEVAL_HEADING_BOOST=0.1
PROCESSING_MAX_RETRIES=3
CHAT_MAX_HISTORY_MESSAGES=6
CHAT_MAX_CONTEXT_CHUNKS=8
FLASHCARD_DEFAULT_COUNT=10
QUIZ_DEFAULT_COUNT=10
TOPIC_MIN_DURATION_SECONDS=90
TOPIC_SIMILARITY_THRESHOLD=0.35

# ---- Storage ----
STORAGE_DIRECTORY=storage/uploads
