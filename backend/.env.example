# Backend environment configuration.
# Copy this file to `.env` and fill in real values. Never commit a real `.env`.
# These names match what the current application reads today. Names will be
# normalised (e.g. MONGODB_DATABASE, CORS via env, API_V1_PREFIX) during the
# backend modularisation step; see docs/migration-plan.md.

# ---- Server ----
# Port the API listens on. Keep in sync with the frontend VITE_API_BASE_URL.
PORT=8000

# ---- Database (MongoDB) ----
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017

# ---- Authentication (JWT) ----
# Generate a long random value, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret

# ---- LLM (Groq) ----
# Get a key from https://console.groq.com
GROQ_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# ---- Speech-to-text (Faster Whisper) ----
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---- Embeddings (Sentence Transformers) ----
EMBEDDING_MODEL=all-MiniLM-L6-v2
