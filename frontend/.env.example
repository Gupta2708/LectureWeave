# Frontend environment configuration.
# Copy this file to `.env` and adjust for your setup. Never commit a real `.env`.
# All values are read through src/config/environment.js.

# Display name for the product.
VITE_APP_NAME=LectureWeave

# Base URL of the backend HTTP API (no trailing slash needed).
VITE_API_BASE_URL=http://localhost:8000

# Base URL of the backend WebSocket endpoint.
VITE_WS_BASE_URL=ws://localhost:8000
